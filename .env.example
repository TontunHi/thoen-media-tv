# Server Port
PORT=3000

# CORS Whitelist (comma-separated origins, or leave blank/asterisk for dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Thoen Media TV Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=thoen_media_tv

# Authentication Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# External Hospital Information System (HOSxP MySQL Database)
HOSXP_DB_HOST=192.168.1.4
HOSXP_DB_PORT=3306
HOSXP_DB_USER=guest
HOSXP_DB_PASSWORD=guest
HOSXP_DB_DATABASE=hos
